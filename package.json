{
  "name": "poop-translator",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run icons && vite build && vite build --config vite.content.config.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "^24.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.0"
  }
}
