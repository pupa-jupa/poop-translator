{
  "name": "poop-translator",
  "version": "1.7.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pupa-jupa/poop-translator.git"
  },
  "homepage": "https://github.com/pupa-jupa/poop-translator#readme",
  "bugs": {
    "url": "https://github.com/pupa-jupa/poop-translator/issues"
  },
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "build": "npm run icons && vite build && vite build --config vite.content.config.ts && npm run ocr-assets",
    "smoke": "node scripts/smoke.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:ocr": "node scripts/ocr-smoke.mjs",
    "smoke:real": "node scripts/real-translation-smoke.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "^24.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@tesseract.js-data/ukr": "1.0.0",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  }
}
